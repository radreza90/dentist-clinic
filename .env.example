MONGODB_URI=mongodb://127.0.0.1:27017/dentist-clinic
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
CLINIC_TIMEZONE=Asia/Tehran

# Used only to encrypt sensitive payment/SMS credentials stored in MongoDB.
# Do not store provider credentials here.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret

CRON_SECRET=change-this-to-a-long-random-cron-secret
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-to-a-long-password
SEED_ADMIN_PHONE=09120000000
