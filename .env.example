MONGODB_URI=mongodb://127.0.0.1:27017/dentist-clinic
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
CLINIC_TIMEZONE=Asia/Tehran

# SMS: console for development, ippanel for production
SMS_DRIVER=console
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
IPPANEL_API_URL=https://edge.ippanel.com/v1/api/send
IPPANEL_TIMEOUT_MS=15000

# Payment: mock for development, zarinpal for production
PAYMENT_DRIVER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_API_BASE_URL=https://api.zarinpal.com
ZARINPAL_STARTPAY_BASE_URL=https://www.zarinpal.com/pg/StartPay
ZARINPAL_TIMEOUT_MS=15000

CRON_SECRET=change-this-to-a-long-random-cron-secret
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-to-a-long-password
SEED_ADMIN_PHONE=09120000000
